# ==============================================================
# DFZ Messenger — Environment Variables Configuration
# ==============================================================

# Application branding
APP_NAME="DFZ Messenger"
NEXT_PUBLIC_APP_NAME="DFZ Messenger"
NODE_ENV=development

# Server Ports
PORT=4000
API_PORT=4000
WEB_PORT=3000

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Local or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dfz_messenger?schema=public"

# Redis Cache / State (Leave empty to use embedded in-memory fallback for local dev)
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (Generate strong random strings in production)
JWT_ACCESS_SECRET="dfz_messenger_super_secret_jwt_access_token_key_2026"
JWT_REFRESH_SECRET="dfz_messenger_super_secret_jwt_refresh_token_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# File Upload & Storage (MinIO or AWS S3)
# Leave STORAGE_DRIVER=local for instant local file storage without S3/MinIO
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"

# S3 / MinIO Configuration (Used if STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="dfz-messenger"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true

# WebRTC STUN / TURN Configuration
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_PASSWORD=

# Security & Rate Limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Admin Initial Seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dfzmessenger.local
ADMIN_PASSWORD=AdminSecure2026!
