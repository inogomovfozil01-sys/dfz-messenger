{
  "name": "dfz-messenger",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready next-generation Web Messenger",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@dfz/api",
    "dev:web": "npm run dev --workspace=@dfz/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@dfz/api",
    "build:web": "npm run db:generate && npm run build --workspace=@dfz/web",
    "db:generate": "npm run db:generate --workspace=@dfz/api",
    "db:push": "npm run db:push --workspace=@dfz/api",
    "db:migrate": "npm run db:migrate --workspace=@dfz/api",
    "db:seed": "npm run db:seed --workspace=@dfz/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "messenger",
    "chat",
    "webrtc",
    "realtime",
    "socket.io",
    "nextjs",
    "prisma",
    "postgresql"
  ],
  "author": "DFZ Engineering",
  "license": "MIT"
}
