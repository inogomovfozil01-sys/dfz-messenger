# ==============================================================
# DFZ Messenger Web Frontend (Vercel Production Environment Variables)
# ==============================================================

# Application branding
NEXT_PUBLIC_APP_NAME="DFZ Messenger"

# Backend API & WebSocket URLs (point to your deployed API server or localhost for dev)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# WebRTC STUN/TURN Servers for Audio/Video Calls
NEXT_PUBLIC_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_PASSWORD=""
