generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
  SAVED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE
  FILE
  SYSTEM
  POLL
  STICKER
  VIDEO_NOTE
}

enum StoryMediaType {
  IMAGE
  VIDEO
  TEXT
}

enum ReceiptStatus {
  SENT
  DELIVERED
  READ
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  CONNECTED
  ENDED
  REJECTED
  MISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  ILLEGAL_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum PrivacyVisibility {
  EVERYONE
  CONTACTS
  NOBODY
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  email            String?      @unique
  phone            String?      @unique
  role             UserRole     @default(USER)
  isBanned         Boolean      @default(false)
  bannedReason     String?
  twoFactorEnabled Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  credential       Credential?
  profile          Profile?
  sessions         Session[]
  contacts         Contact[]    @relation("UserContacts")
  contactOf        Contact[]    @relation("TargetContacts")
  chatMemberships  ChatMember[]
  messages         Message[]    @relation("SentMessages")
  forwardedMsgs    Message[]    @relation("ForwardedFrom")
  reactions        Reaction[]
  receipts         MessageReceipt[]
  ownedChats       Chat[]       @relation("ChatOwner")
  blockedUsers     Block[]      @relation("Blocker")
  blockedBy        Block[]      @relation("Blocked")
  reportsFiled     Report[]     @relation("ReportReporter")
  auditLogs        AuditLog[]
  outgoingCalls    Call[]       @relation("CallerCalls")
  incomingCalls    Call[]       @relation("ReceiverCalls")
  pinnedMessages   PinnedMessage[]
  folders          ChatFolder[]
  stories          Story[]          @relation("UserStories")
  storyViews       StoryView[]      @relation("UserStoryViews")
  storyReactions   StoryReaction[]  @relation("UserStoryReactions")
  pollVotes        PollVote[]       @relation("UserPollVotes")
  createdTopics    Topic[]          @relation("UserTopics")

  @@index([username])
  @@index([email])
}

model Credential {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash     String
  twoFactorSecret  String?
  updatedAt        DateTime @updatedAt
}

model Profile {
  id                 String            @id @default(uuid())
  userId             String            @unique
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  bio                String?
  avatarUrl          String?
  lastSeenAt         DateTime?
  lastSeenVisibility PrivacyVisibility @default(EVERYONE)
  messageVisibility  PrivacyVisibility @default(EVERYONE)
  callVisibility     PrivacyVisibility @default(EVERYONE)
  groupAddVisibility PrivacyVisibility @default(EVERYONE)
  photoVisibility    PrivacyVisibility @default(EVERYONE)
  theme              String            @default("dark")
  language           String            @default("ru")
  updatedAt          DateTime          @updatedAt
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  deviceName   String?
  browser      String?
  os           String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Contact {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactUserId String
  contactUser   User     @relation("TargetContacts", fields: [contactUserId], references: [id], onDelete: Cascade)
  nickname      String?
  createdAt     DateTime @default(now())

  @@unique([userId, contactUserId])
  @@index([userId])
}

model Chat {
  id          String       @id @default(uuid())
  type        ChatType     @default(DIRECT)
  title       String?
  description String?
  avatarUrl   String?
  ownerId     String?
  owner       User?        @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isPublic    Boolean      @default(false)
  isForum     Boolean      @default(false)
  inviteCode  String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members        ChatMember[]
  messages       Message[]
  pinnedMessages PinnedMessage[]
  calls          Call[]
  topics         Topic[]

  @@index([type])
  @@index([ownerId])
  @@index([inviteCode])
}

model ChatMember {
  id          String      @id @default(uuid())
  chatId      String
  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole  @default(MEMBER)
  permissions Json?
  customTitle String?
  isMuted     Boolean     @default(false)
  mutedUntil  DateTime?
  isPinned    Boolean     @default(false)
  isArchived  Boolean     @default(false)
  joinedAt    DateTime    @default(now())

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
}

model Message {
  id              String         @id @default(uuid())
  chatId          String
  chat            Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User           @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  topicId         String?
  topic           Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  replyToId       String?
  replyTo         Message?       @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]      @relation("MessageReplies")
  forwardedFromId String?
  forwardedFrom   User?          @relation("ForwardedFrom", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  content         String
  type            MessageType    @default(TEXT)
  isEdited        Boolean        @default(false)
  isDeleted       Boolean        @default(false)
  idempotencyKey  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  attachments    Attachment[]
  receipts       MessageReceipt[]
  reactions      Reaction[]
  pinnedInChats  PinnedMessage[]
  poll           Poll?

  @@index([chatId, createdAt])
  @@index([chatId, id])
  @@index([topicId])
  @@index([senderId])
  @@index([idempotencyKey])
}

model MessageReceipt {
  id        String        @id @default(uuid())
  messageId String
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReceiptStatus @default(DELIVERED)
  updatedAt DateTime      @updatedAt

  @@unique([messageId, userId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model Attachment {
  id           String   @id @default(uuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  url          String
  thumbnailUrl String?
  duration     Int?
  waveform     Json?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  @@index([messageId])
}

model PinnedMessage {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById String
  pinnedBy   User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  pinnedAt   DateTime @default(now())

  @@unique([chatId, messageId])
  @@index([chatId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Call {
  id              String     @id @default(uuid())
  chatId          String
  chat            Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  callerId        String
  caller          User       @relation("CallerCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiverId      String?
  receiver        User?      @relation("ReceiverCalls", fields: [receiverId], references: [id], onDelete: SetNull)
  type            CallType   @default(AUDIO)
  status          CallStatus @default(RINGING)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int        @default(0)
  createdAt       DateTime   @default(now())

  @@index([chatId])
  @@index([callerId])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String       // USER, CHAT, MESSAGE
  targetId   String
  reason     ReportReason
  comment    String?
  status     ReportStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  target    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model ChatFolder {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  icon       String?
  filterType String   // ALL, PERSONAL, GROUPS, CHANNELS, UNREAD, CUSTOM
  chatIds    Json?    // list of specific chat IDs for custom folders
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Story {
  id          String            @id @default(uuid())
  authorId    String
  author      User              @relation("UserStories", fields: [authorId], references: [id], onDelete: Cascade)
  mediaUrl    String
  mediaType   StoryMediaType    @default(IMAGE)
  caption     String?
  textOverlay Json?
  privacy     PrivacyVisibility @default(EVERYONE)
  expiresAt   DateTime
  isArchived  Boolean           @default(false)
  createdAt   DateTime          @default(now())

  views       StoryView[]
  reactions   StoryReaction[]

  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation("UserStoryViews", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserStoryReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([storyId, userId, emoji])
  @@index([storyId])
  @@index([userId])
}

model Poll {
  id            String       @id @default(uuid())
  chatId        String
  messageId     String       @unique
  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question      String
  isAnonymous   Boolean      @default(false)
  allowMultiple Boolean      @default(false)
  isClosed      Boolean      @default(false)
  createdAt     DateTime     @default(now())

  options       PollOption[]
  votes         PollVote[]

  @@index([chatId])
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  voteCount Int        @default(0)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  votedAt   DateTime   @default(now())

  @@unique([pollId, optionId, userId])
  @@index([pollId])
  @@index([userId])
}

model Topic {
  id        String    @id @default(uuid())
  chatId    String
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  title     String
  icon      String?
  color     String?
  creatorId String
  creator   User      @relation("UserTopics", fields: [creatorId], references: [id], onDelete: Cascade)
  isClosed  Boolean   @default(false)
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([chatId])
}

model StickerPack {
  id         String    @id @default(uuid())
  name       String    @unique
  title      String
  author     String?
  isOfficial Boolean   @default(false)
  stickers   Sticker[]
  createdAt  DateTime  @default(now())
}

model Sticker {
  id        String      @id @default(uuid())
  packId    String
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  emoji     String
  url       String
  width     Int?
  height    Int?
  createdAt DateTime    @default(now())

  @@index([packId])
}
